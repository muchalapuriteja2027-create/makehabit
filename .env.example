# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
APP_URL="MY_APP_URL"

# Render Backend API URL (for payment order creation & HMAC payment verification)
VITE_BACKEND_URL="https://makehabit-twbz.onrender.com"

# Razorpay Test Mode Configuration
# 1. Obtain test API keys from Razorpay Dashboard: Settings -> API Keys -> Generate Test Key.
# 2. VITE_RAZORPAY_KEY_ID: Public Key ID (e.g. rzp_test_xxxxxxxxxxxxxx). Safe for client.
# 3. RAZORPAY_KEY_SECRET: Private Secret Key. Keep on server ONLY (e.g. Render Environment Variables). Never commit or expose to frontend.
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"

# Optional public analytics/verification identifiers. These are not API secrets.
# Microsoft Clarity: create a project and copy its Project ID from Settings -> Setup.
VITE_CLARITY_PROJECT_ID=""
# Google Search Console URL-prefix property: copy only the token value from the HTML-tag verification method.
VITE_GOOGLE_SITE_VERIFICATION=""
