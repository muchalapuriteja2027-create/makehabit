# Frontend host URL. AI Studio may inject its runtime URL.
APP_URL="MY_APP_URL"

# Render backend URL for payment order creation and verification.
VITE_BACKEND_URL="https://makehabit-twbz.onrender.com"

# Razorpay TEST MODE only. Never put a key secret in Vite variables or frontend files.
VITE_RAZORPAY_KEY_ID="rzp_test_YourTestKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpayTestSecretHere"
RAZORPAY_MODE="test"

# Server-side Firebase Admin SDK: required for persistent Premium entitlement activation.
# Leave blank unless the Firebase project owner provides an authorized service-account JSON.
# Store it ONLY in Render environment variables, never commit the actual value.
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_PROJECT_ID="tangential-realm-08f9p"
FIRESTORE_DATABASE_ID="ai-studio-makehabit-64d2424e-d978-4e00-aa84-e6bfb582bbe9"

# Optional public site identifiers (not secrets). Clarity is configured in the GitHub Pages workflow.
# Google Search Console HTML-tag token is only needed for a URL-prefix property using that method.
VITE_GOOGLE_SITE_VERIFICATION=""

# Live keys are intentionally not configured. Do not switch to live until server-side Firebase
# entitlement activation is authorized, deployed, and verified end-to-end.
# RAZORPAY_MODE="live"
# RAZORPAY_LIVE_KEY_ID="rzp_live_..."
# RAZORPAY_LIVE_KEY_SECRET="..."
